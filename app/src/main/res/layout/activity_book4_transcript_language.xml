<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/activity_dialog_upgrade_min_width"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/activity_dialog_upgrade_padding"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#00585858"
            app:cardCornerRadius="0px"
            app:cardElevation="0px"
            android:layout_gravity="center|center_vertical"
            android:layout_margin="5px"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >
                    <TextView
                        android:id="@+id/tvDialogTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/activity_dialog_upgrade_text_size1"
                        android:text="AI transcription language"
                        android:textColor="#000000"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:visibility="visible"
                        />
                    <!--New note-->
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24px"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Selecting a language enhances word recognition during recordings. This setting can be changed anytime."
                            android:layout_margin="0px"
                            android:textSize="@dimen/activity_dialog_upgrade_text_size2"
                            />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="40dp"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="0px"
                            android:layout_weight="0"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_baseline_content_cut_24"
                            />

                        <RadioButton
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:checked="false"
                            android:enabled="true"
                            android:text=""
                            android:id="@+id/rbDefaultChoose"
                            android:visibility="visible"
                            android:layout_marginRight="-10dp"
                            />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/activity_dialog_upgrade_text_size2"
                            android:text="English"
                            android:textColor="#000000"
                            android:layout_gravity="left|center_vertical"
                            android:gravity="left|center_vertical"
                            android:layout_marginLeft="0dp"
                            android:layout_marginRight="20dp"
                            android:visibility="visible"
                            android:textStyle="bold"
                            android:id="@+id/tvDefaultChoose"
                            />

                        <RadioButton
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:checked="false"
                            android:enabled="true"
                            android:paddingStart="48px"
                            android:text=""
                            android:id="@+id/rbDefaultChoose0"
                            android:visibility="invisible"
                            />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:background="#000000"
                        android:visibility="visible"
                        />

                    <LinearLayout
                        android:id="@+id/llLanguageItem1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        android:visibility="visible"
                        >
                        <ImageView
                            android:layout_width="0px"
                            android:layout_weight="0"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_baseline_content_cut_24"
                            />

                        <RadioButton
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:checked="false"
                            android:enabled="true"
                            android:text=""
                            android:visibility="invisible"
                            android:tag="rbChoose"
                            android:layout_marginRight="-10dp"
                            />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/activity_dialog_upgrade_text_size2"
                            android:text="French"
                            android:textColor="#000000"
                            android:layout_gravity="left|center_vertical"
                            android:gravity="left|center_vertical"
                            android:layout_marginLeft="0dp"
                            android:layout_marginRight="20dp"
                            android:visibility="visible"
                            android:textStyle="bold"
                            android:tag="tvChoose"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:layout_marginRight="20px"
                            android:layout_gravity="center_vertical|center"
                            android:tag="tvStatus"
                            />

                        <ImageView
                            android:layout_width="40px"
                            android:layout_weight="0"
                            android:layout_height="40px"
                            android:layout_marginRight="20px"
                            android:src="@drawable/ic_outline_delete_forever_24"
                            android:layout_gravity="center_vertical|center"
                            android:tag="ivDelete"
                            android:layout_centerVertical="true"
                            android:layout_marginLeft="5px"
                            android:visibility="gone"
                            />

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            >
                            <ImageView
                                android:layout_width="40px"
                                android:layout_weight="0"
                                android:layout_height="40px"
                                android:layout_marginRight="20px"
                                android:src="@drawable/ic_outline_delete_forever_24"
                                android:layout_gravity="center_vertical|center"
                                android:tag="ivStop"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="5px"
                                android:visibility="invisible"
                                />

                            <ImageView
                                android:layout_width="40px"
                                android:layout_weight="0"
                                android:layout_height="40px"
                                android:layout_marginRight="20px"
                                android:src="@drawable/ic_baseline_download_24"
                                android:layout_gravity="center_vertical|center"
                                android:tag="ivDownload"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="5px"
                                />

                            <RadioButton
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:checked="false"
                                android:enabled="true"
                                android:paddingStart="48px"
                                android:text=""
                                android:visibility="invisible"
                                android:tag="rbChoose0"
                                />
                        </RelativeLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:background="#000000"
                        android:visibility="visible"
                        />

                    <LinearLayout
                        android:id="@+id/llLanguageItem2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        android:visibility="visible"
                        >
                        <ImageView
                            android:layout_width="0px"
                            android:layout_weight="0"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_baseline_content_cut_24"
                            />

                        <RadioButton
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:checked="false"
                            android:enabled="true"
                            android:text=""
                            android:visibility="invisible"
                            android:tag="rbChoose"
                            android:layout_marginRight="-10dp"
                            />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/activity_dialog_upgrade_text_size2"
                            android:text="German"
                            android:textColor="#000000"
                            android:layout_gravity="left|center_vertical"
                            android:gravity="left|center_vertical"
                            android:layout_marginLeft="0dp"
                            android:layout_marginRight="20dp"
                            android:visibility="visible"
                            android:textStyle="bold"
                            android:tag="tvChoose"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:layout_marginRight="20px"
                            android:layout_gravity="center_vertical|center"
                            android:tag="tvStatus"
                            />

                        <ImageView
                            android:layout_width="40px"
                            android:layout_weight="0"
                            android:layout_height="40px"
                            android:layout_marginRight="20px"
                            android:src="@drawable/ic_outline_delete_forever_24"
                            android:layout_gravity="center_vertical|center"
                            android:tag="ivDelete"
                            android:layout_centerVertical="true"
                            android:layout_marginLeft="5px"
                            android:visibility="gone"
                            />

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            >
                            <ImageView
                                android:layout_width="40px"
                                android:layout_weight="0"
                                android:layout_height="40px"
                                android:layout_marginRight="20px"
                                android:src="@drawable/ic_outline_delete_forever_24"
                                android:layout_gravity="center_vertical|center"
                                android:tag="ivStop"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="5px"
                                android:visibility="invisible"
                                />

                            <ImageView
                                android:layout_width="40px"
                                android:layout_weight="0"
                                android:layout_height="40px"
                                android:layout_marginRight="20px"
                                android:src="@drawable/ic_baseline_download_24"
                                android:layout_gravity="center_vertical|center"
                                android:tag="ivDownload"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="5px"
                                />

                            <RadioButton
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:checked="false"
                                android:enabled="true"
                                android:paddingStart="48px"
                                android:text=""
                                android:visibility="invisible"
                                android:tag="rbChoose0"
                                />
                        </RelativeLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:background="#000000"
                        android:visibility="visible"
                        />

                    <LinearLayout
                        android:id="@+id/llLanguageItem3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        android:visibility="visible"
                        >
                        <ImageView
                            android:layout_width="0px"
                            android:layout_weight="0"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_baseline_content_cut_24"
                            />

                        <RadioButton
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:checked="false"
                            android:enabled="true"
                            android:text=""
                            android:visibility="invisible"
                            android:tag="rbChoose"
                            android:layout_marginRight="-10dp"
                            />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/activity_dialog_upgrade_text_size2"
                            android:text="Spanish"
                            android:textColor="#000000"
                            android:layout_gravity="left|center_vertical"
                            android:gravity="left|center_vertical"
                            android:layout_marginLeft="0dp"
                            android:layout_marginRight="20dp"
                            android:visibility="visible"
                            android:textStyle="bold"
                            android:tag="tvChoose"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:layout_marginRight="20px"
                            android:layout_gravity="center_vertical|center"
                            android:tag="tvStatus"
                            />

                        <ImageView
                            android:layout_width="40px"
                            android:layout_weight="0"
                            android:layout_height="40px"
                            android:layout_marginRight="20px"
                            android:src="@drawable/ic_outline_delete_forever_24"
                            android:layout_gravity="center_vertical|center"
                            android:tag="ivDelete"
                            android:layout_centerVertical="true"
                            android:layout_marginLeft="5px"
                            android:visibility="gone"
                            />

                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            >
                            <ImageView
                                android:layout_width="40px"
                                android:layout_weight="0"
                                android:layout_height="40px"
                                android:layout_marginRight="20px"
                                android:src="@drawable/ic_outline_delete_forever_24"
                                android:layout_gravity="center_vertical|center"
                                android:tag="ivStop"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="5px"
                                android:visibility="invisible"
                                />

                            <ImageView
                                android:layout_width="40px"
                                android:layout_weight="0"
                                android:layout_height="40px"
                                android:layout_marginRight="20px"
                                android:src="@drawable/ic_baseline_download_24"
                                android:layout_gravity="center_vertical|center"
                                android:tag="ivDownload"
                                android:layout_centerVertical="true"
                                android:layout_marginLeft="5px"
                                />

                            <RadioButton
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:checked="false"
                                android:enabled="true"
                                android:paddingStart="48px"
                                android:text=""
                                android:visibility="invisible"
                                android:tag="rbChoose0"
                                />
                        </RelativeLayout>
                    </LinearLayout>


                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right"
                    android:layout_marginTop="16px"
                    android:layout_marginRight="0px"
                    >
                    <!--
                    -->
                    <Button
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="@dimen/activity_dialog_upgrade_btn_width_delete1"
                        android:layout_height="@dimen/activity_dialog_upgrade_btn_height_delete1"
                        android:text="Cancel"
                        android:textSize="@dimen/activity_dialog_upgrade_text_size3"
                        app:icon="@null"
                        android:id="@+id/btnCancel"
                        android:padding="0px"
                        android:textColor="#000000"
                        android:layout_gravity="center_vertical"
                        android:visibility="gone"
                        />
                    <Button
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="@dimen/activity_dialog_upgrade_btn_width_delete1"
                        android:layout_height="@dimen/activity_dialog_upgrade_btn_height_delete1"
                        android:text="Done"
                        android:textSize="@dimen/activity_dialog_upgrade_text_size3"
                        app:icon="@null"
                        android:id="@+id/btnSave"
                        android:paddingLeft="0px"
                        android:paddingRight="0px"
                        android:paddingTop="0px"
                        android:paddingBottom="0px"
                        android:textColor="#000000"
                        android:layout_gravity="center_vertical"
                        />
                    <!--app:icon="@drawable/ic_outline_delete_forever_24_w"
                        -->
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>

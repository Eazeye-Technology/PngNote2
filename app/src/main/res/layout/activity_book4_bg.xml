<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/activity_dialog_bg_min_width"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/activity_dialog_bg_padding"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#00585858"
            app:cardCornerRadius="0px"
            app:cardElevation="0px"
            android:layout_gravity="center|center_vertical"
            >
            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/activity_dialog_bg_text_size1"
                            android:text="Page background"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/activity_dialog_bg_table_height"
                        >
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            >
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:layout_marginTop="10px"
                                >

                                <androidx.cardview.widget.CardView
                                    android:layout_width="0px"
                                    android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="#00585858"
                                    app:cardCornerRadius="20px"
                                    app:cardElevation="1px"
                                    android:layout_gravity="center|center_vertical"
                                    >
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                        android:orientation="vertical"
                                        android:id="@+id/llradio1"
                                        >
                                        <ImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                            android:src="@drawable/ic_my_bg_blank_001"
                                            android:scaleType="fitXY"
                                            />

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentLeft="true"
                                            android:layout_alignParentBottom="true"
                                            android:layout_marginBottom="17px"
                                            app:cardBackgroundColor="#E0E0E0"
                                            app:cardCornerRadius="5px"
                                            android:layout_marginLeft="-5px"
                                            >
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_weight="1"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/activity_dialog_bg_grid_text_size"
                                                android:text="Blank"
                                                android:textColor="#FF000000"
                                                android:visibility="visible"
                                                android:layout_marginRight="10px"
                                                android:layout_marginLeft="10px"
                                                />
                                        </androidx.cardview.widget.CardView>

                                        <RelativeLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="44px"
                                            android:background="#F4F0EF"
                                            >

                                            <View
                                                android:layout_width="0px"
                                                android:layout_height="20px"
                                                android:id="@+id/centerView1"
                                                android:layout_centerInParent="true"
                                                />
                                            <RadioButton
                                                android:id="@+id/radio1"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:checked="false"
                                                android:drawablePadding="0px"
                                                android:enabled="true"
                                                android:gravity="center|center_vertical"
                                                android:layout_marginLeft="-15px"
                                                android:layout_alignLeft="@+id/centerView1"
                                                android:textSize="25px"
                                                />
                                        </RelativeLayout>
                                </RelativeLayout>
                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="0px"
                                    android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="#00585858"
                                    app:cardCornerRadius="20px"
                                    app:cardElevation="1px"
                                    android:layout_gravity="center|center_vertical"
                                    android:layout_marginLeft="10px"
                                    >
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                        android:orientation="vertical"
                                        android:id="@+id/llradio2"
                                        >
                                        <ImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                            android:src="@drawable/ic_my_bg_lined_002"
                                            android:scaleType="fitXY"
                                            />

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentLeft="true"
                                            android:layout_alignParentBottom="true"
                                            android:layout_marginBottom="17px"
                                            app:cardBackgroundColor="#E0E0E0"
                                            app:cardCornerRadius="5px"
                                            android:layout_marginLeft="-5px"
                                            >
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_weight="1"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/activity_dialog_bg_grid_text_size"
                                                android:text="Lined"
                                                android:textColor="#FF000000"
                                                android:visibility="visible"
                                                android:layout_marginRight="10px"
                                                android:layout_marginLeft="10px"
                                                />
                                        </androidx.cardview.widget.CardView>

                                        <RelativeLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="44px"
                                            android:background="#F4F0EF"
                                            >

                                            <View
                                                android:layout_width="0px"
                                                android:layout_height="20px"
                                                android:id="@+id/centerView2"
                                                android:layout_centerInParent="true"
                                                />
                                            <RadioButton
                                                android:id="@+id/radio2"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:checked="false"
                                                android:drawablePadding="0px"
                                                android:enabled="true"
                                                android:gravity="center|center_vertical"
                                                android:layout_marginLeft="-15px"
                                                android:layout_alignLeft="@+id/centerView2"
                                                android:textSize="25px"
                                                />
                                        </RelativeLayout>
                                    </RelativeLayout>
                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="0px"
                                    android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="#00585858"
                                    app:cardCornerRadius="20px"
                                    app:cardElevation="1px"
                                    android:layout_gravity="center|center_vertical"
                                    android:layout_marginLeft="10px"
                                    >
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                        android:orientation="vertical"
                                        android:id="@+id/llradio3"
                                        >
                                        <ImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                            android:src="@drawable/ic_my_bg_lined_long_dash_003"
                                            android:scaleType="fitXY"
                                            />

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentLeft="true"
                                            android:layout_alignParentBottom="true"
                                            android:layout_marginBottom="17px"
                                            app:cardBackgroundColor="#E0E0E0"
                                            app:cardCornerRadius="5px"
                                            android:layout_marginLeft="-5px"
                                            >
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_weight="1"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/activity_dialog_bg_grid_text_size"
                                                android:text="Lined long dash"
                                                android:textColor="#FF000000"
                                                android:visibility="visible"
                                                android:layout_marginRight="10px"
                                                android:layout_marginLeft="10px"
                                                />
                                        </androidx.cardview.widget.CardView>


                                        <RelativeLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="44px"
                                            android:background="#F4F0EF"
                                            >

                                            <View
                                                android:layout_width="0px"
                                                android:layout_height="20px"
                                                android:id="@+id/centerView3"
                                                android:layout_centerInParent="true"
                                                />
                                            <RadioButton
                                                android:id="@+id/radio3"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:checked="false"
                                                android:drawablePadding="0px"
                                                android:enabled="true"
                                                android:gravity="center|center_vertical"
                                                android:layout_marginLeft="-15px"
                                                android:layout_alignLeft="@+id/centerView3"
                                                android:textSize="25px"
                                                />
                                        </RelativeLayout>
                                    </RelativeLayout>
                                </androidx.cardview.widget.CardView>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:layout_marginTop="10px"
                                >
                                <androidx.cardview.widget.CardView
                                    android:layout_width="0px"
                                    android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="#00585858"
                                    app:cardCornerRadius="20px"
                                    app:cardElevation="1px"
                                    android:layout_gravity="center|center_vertical"
                                    >
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                        android:orientation="vertical"
                                        android:id="@+id/llradio4"
                                        >
                                        <ImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                            android:src="@drawable/ic_my_bg_lined_dash_004"
                                            android:scaleType="fitXY"
                                            />

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentLeft="true"
                                            android:layout_alignParentBottom="true"
                                            android:layout_marginBottom="17px"
                                            app:cardBackgroundColor="#E0E0E0"
                                            app:cardCornerRadius="5px"
                                            android:layout_marginLeft="-5px"
                                            >
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_weight="1"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/activity_dialog_bg_grid_text_size"
                                                android:text="Lined dot"
                                                android:textColor="#FF000000"
                                                android:visibility="visible"
                                                android:layout_marginRight="10px"
                                                android:layout_marginLeft="10px"
                                                />
                                        </androidx.cardview.widget.CardView>


                                        <RelativeLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="44px"
                                            android:background="#F4F0EF"
                                            >

                                            <View
                                                android:layout_width="0px"
                                                android:layout_height="20px"
                                                android:id="@+id/centerView4"
                                                android:layout_centerInParent="true"
                                                />
                                            <RadioButton
                                                android:id="@+id/radio4"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:checked="false"
                                                android:drawablePadding="0px"
                                                android:enabled="true"
                                                android:gravity="center|center_vertical"
                                                android:layout_marginLeft="-15px"
                                                android:layout_alignLeft="@+id/centerView4"
                                                android:textSize="25px"
                                                />
                                        </RelativeLayout>
                                    </RelativeLayout>
                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="0px"
                                    android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="#00585858"
                                    app:cardCornerRadius="20px"
                                    app:cardElevation="1px"
                                    android:layout_gravity="center|center_vertical"
                                    android:layout_marginLeft="10px"
                                    >
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                        android:orientation="vertical"
                                        android:id="@+id/llradio5"
                                        >
                                        <ImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                            android:src="@drawable/ic_my_bg_dots_005"
                                            android:scaleType="fitXY"
                                            />

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentLeft="true"
                                            android:layout_alignParentBottom="true"
                                            android:layout_marginBottom="17px"
                                            app:cardBackgroundColor="#E0E0E0"
                                            app:cardCornerRadius="5px"
                                            android:layout_marginLeft="-5px"
                                            >
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_weight="1"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/activity_dialog_bg_grid_text_size"
                                                android:text="Dotted grid"
                                                android:textColor="#FF000000"
                                                android:visibility="visible"
                                                android:layout_marginRight="10px"
                                                android:layout_marginLeft="10px"
                                                />
                                        </androidx.cardview.widget.CardView>


                                        <RelativeLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="44px"
                                            android:background="#F4F0EF"
                                            >

                                            <View
                                                android:layout_width="0px"
                                                android:layout_height="20px"
                                                android:id="@+id/centerView5"
                                                android:layout_centerInParent="true"
                                                />
                                            <RadioButton
                                                android:id="@+id/radio5"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:checked="false"
                                                android:drawablePadding="0px"
                                                android:enabled="true"
                                                android:gravity="center|center_vertical"
                                                android:layout_marginLeft="-15px"
                                                android:layout_alignLeft="@+id/centerView5"
                                                android:textSize="25px"
                                                />
                                        </RelativeLayout>
                                    </RelativeLayout>
                                </androidx.cardview.widget.CardView>

                                <androidx.cardview.widget.CardView
                                    android:layout_width="0px"
                                    android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="#00585858"
                                    app:cardCornerRadius="20px"
                                    app:cardElevation="1px"
                                    android:layout_gravity="center|center_vertical"
                                    android:layout_marginLeft="10px"
                                    >
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                        android:orientation="vertical"
                                        android:id="@+id/llradio6"
                                        >
                                        <ImageView
                                            android:layout_width="match_parent"
                                            android:layout_height="@dimen/activity_dialog_bg_grid_height"
                                            android:src="@drawable/ic_my_bg_net_dash_006"
                                            android:scaleType="fitXY"
                                            />

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_alignParentLeft="true"
                                            android:layout_alignParentBottom="true"
                                            android:layout_marginBottom="17px"
                                            app:cardBackgroundColor="#E0E0E0"
                                            app:cardCornerRadius="5px"
                                            android:layout_marginLeft="-5px"
                                            >
                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_weight="1"
                                                android:layout_height="wrap_content"
                                                android:textSize="@dimen/activity_dialog_bg_grid_text_size"
                                                android:text="Lined dotted grid"
                                                android:textColor="#FF000000"
                                                android:visibility="visible"
                                                android:layout_marginRight="10px"
                                                android:layout_marginLeft="10px"
                                                />
                                        </androidx.cardview.widget.CardView>


                                        <RelativeLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="44px"
                                            android:background="#F4F0EF"
                                            >

                                            <View
                                                android:layout_width="0px"
                                                android:layout_height="20px"
                                                android:id="@+id/centerView6"
                                                android:layout_centerInParent="true"
                                                />
                                            <RadioButton
                                                android:id="@+id/radio6"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:checked="false"
                                                android:drawablePadding="0px"
                                                android:enabled="true"
                                                android:gravity="center|center_vertical"
                                                android:layout_marginLeft="-15px"
                                                android:layout_alignLeft="@+id/centerView6"
                                                android:textSize="25px"
                                                />
                                        </RelativeLayout>
                                    </RelativeLayout>
                                </androidx.cardview.widget.CardView>

                            </LinearLayout>
                        </LinearLayout>
                    </ScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1px"
                        android:orientation="horizontal"
                        android:gravity="right"
                        android:layout_marginRight="-10px"
                        android:layout_marginTop="20px"
                        >
                        <Button
                            style="@style/Widget.Material3.Button.TextButton.Icon"
                            android:layout_width="76px"
                            android:layout_height="40px"
                            android:text="Cancel"
                            android:textSize="14px"
                            app:icon="@null"
                            android:id="@+id/btnCancel"
                            android:padding="0px"
                            android:textColor="#000000"
                            />
                        <!--android:textStyle="bold"
                            -->
                        <Button
                            style="@style/Widget.Material3.Button.TextButton.Icon"
                            android:layout_width="76px"
                            android:layout_height="40px"
                            android:text="Done"
                            android:textSize="14px"
                            app:icon="@null"
                            android:id="@+id/btnSave"
                            android:padding="0px"
                            android:textColor="#000000"
                            />
                    </LinearLayout>
                </LinearLayout>
            </RadioGroup>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>

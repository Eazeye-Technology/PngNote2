<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="0dp"
        android:gravity="center_vertical"
        android:id="@+id/llTab"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="left"
            >
            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="5dp"
                android:id="@+id/btnTitleBack"
                >

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/ic_baseline_arrow_back_24"
                    />

            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My first note"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:id="@+id/spaceVertical"
            android:visibility="gone"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="right"
            >


            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="5dp"
                >

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/ic_baseline_more_vert_24"
                    />

            </RelativeLayout>

            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="5dp"
                android:id="@+id/btnTitleUndo"
                >

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/ic_baseline_undo_24"
                    />

            </RelativeLayout>

            <RelativeLayout
                android:orientation="vertical"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="5dp"
                android:id="@+id/btnTitleRedo"
                >

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/ic_baseline_redo_24"
                    />

            </RelativeLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F1EDEC"
        >
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F1EDEC"
                android:padding="10dp"
                android:gravity="center_vertical|center"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#000000"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    android:layout_gravity="center"
                    android:id="@+id/top_toolkit_item1"
                    >
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        >
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/mtmobile__treefontsize5"
                            android:layout_height="@dimen/mtmobile__treefontsize5"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:background="@drawable/ic_baseline_draw_24_white"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:tag="binding_1"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/mtmobile__treefontsize4"
                            android:text="Drawing"
                            android:textColor="#ffffff"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            android:tag="binding_5"
                            />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F1EDEC"
                android:padding="10dp"
                android:gravity="center_vertical|center"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#00000000"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    android:layout_gravity="center"
                    android:id="@+id/top_toolkit_item2"
                    >
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        >
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/mtmobile__treefontsize5"
                            android:layout_height="@dimen/mtmobile__treefontsize5"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:background="@drawable/ic_baseline_font_download_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:tag="binding_1"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/mtmobile__treefontsize4"
                            android:text="Typing"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            android:tag="binding_5"
                            />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F1EDEC"
                android:padding="10dp"
                android:gravity="center_vertical|center"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#00000000"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    android:layout_gravity="center"
                    android:id="@+id/top_toolkit_item3"
                    >
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        >
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/mtmobile__treefontsize5"
                            android:layout_height="@dimen/mtmobile__treefontsize5"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:background="@drawable/ic_baseline_people_outline_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:tag="binding_1"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/mtmobile__treefontsize4"
                            android:text="AI Note Talking"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            android:tag="binding_5"
                            />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F1EDEC"
                android:padding="10dp"
                android:gravity="center_vertical|center"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#00000000"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    android:layout_gravity="center"
                    android:id="@+id/top_toolkit_item4"
                    >
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        >
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/mtmobile__treefontsize5"
                            android:layout_height="@dimen/mtmobile__treefontsize5"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:background="@drawable/ic_baseline_format_shapes_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:tag="binding_1"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/mtmobile__treefontsize4"
                            android:text="Selection"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            android:tag="binding_5"
                            />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F1EDEC"
            android:padding="10dp"
            android:gravity="center_vertical|center"
            android:layout_gravity="center_vertical|center"
            >
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:layout_gravity="center|center_vertical"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="0dp"
                    >
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:scaleType="fitCenter"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:background="@drawable/ic_baseline_keyboard_arrow_up_24_white"
                        android:text="PEN"
                        android:layout_gravity="center"
                        android:gravity="center"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/mtmobile__treefontsize4"
                        android:text="Drawing"
                        android:textColor="#ffffff"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_marginLeft="10px"
                        android:layout_marginRight="10px"
                        android:visibility="gone"
                        />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bookTab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/toolbar"
        android:orientation="vertical"
        android:visibility="gone">
        <include layout="@layout/book_toolbar"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.txkj.notemobile2.ui.CanvasBoox
            android:id="@+id/canvas"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:background="@android:color/transparent"
            />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_marginLeft="50dp"
            >
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#F1EDEC"
                app:cardCornerRadius="40dp"
                app:cardElevation="1dp"
                android:layout_gravity="center|center_vertical"
                >
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    >
                    <!--ic_baseline_filter_none_24-->
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#585858"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="0dp"
                        android:layout_gravity="center|center_vertical"
                        android:layout_margin="5dp"
                        android:id="@+id/left_toolkit_item1"
                        >
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            >
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_centerVertical="true"
                                android:scaleType="fitCenter"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp"
                                android:textSize="11sp"
                                android:textAllCaps="true"
                                android:background="@drawable/ic_baseline_edit_24_white"
                                android:text="PEN"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:tag="binding_1"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/mtmobile__treefontsize4"
                                android:text="Drawing"
                                android:textColor="#ffffff"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginLeft="10px"
                                android:layout_marginRight="10px"
                                android:visibility="gone"
                                />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#00585858"
                        app:cardCornerRadius="30dp"
                        app:cardElevation="0dp"
                        android:layout_gravity="center|center_vertical"
                        android:layout_margin="5dp"
                        android:id="@+id/left_toolkit_item2"
                        >
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="0dp"
                            >
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_centerVertical="true"
                                android:scaleType="fitCenter"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp"
                                android:textSize="11sp"
                                android:textAllCaps="true"
                                android:background="@mipmap/eraser_button"
                                android:text="PEN"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:tag="binding_1"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/mtmobile__treefontsize4"
                                android:text="Drawing"
                                android:textColor="#ffffff"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginLeft="10px"
                                android:layout_marginRight="10px"
                                android:visibility="gone"
                                />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>

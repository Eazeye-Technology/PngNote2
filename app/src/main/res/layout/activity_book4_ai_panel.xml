<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#F1EDEC"
        app:cardCornerRadius="40dp"
        app:cardElevation="1dp"
        android:layout_gravity="center|center_vertical"
        android:paddingBottom="20dp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="#F6F3F2"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:orientation="horizontal"
                    >
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:text="Meeting"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_gravity="center"
                        android:gravity="left"
                        android:layout_marginLeft="10px"
                        android:layout_marginRight="10px"
                        android:visibility="visible"
                        />
                    <ImageView
                        android:id="@+id/closeTrans"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_baseline_close_24"
                        />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="#ffffff"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        >
                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:id="@+id/rlInfo"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:text="Info"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:layout_gravity="center"
                                android:gravity="center|center_vertical"
                                android:visibility="visible"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                />
                            <View
                                android:layout_alignParentBottom="true"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#000000"
                                android:id="@+id/bottomLineInfo"
                                />
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:id="@+id/rlTranscript"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:text="Transcript"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:layout_gravity="center"
                                android:gravity="center|center_vertical"
                                android:visibility="visible"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                />
                            <View
                                android:layout_alignParentBottom="true"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#000000"
                                android:visibility="invisible"
                                android:id="@+id/bottomLineTranscript"
                                />
                        </RelativeLayout>
                    </LinearLayout>

                    <View
                        android:layout_alignParentBottom="true"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#cccccc"
                        />


                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:id="@+id/llInfo"
                            android:visibility="visible"
                            >
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                >
                                <include layout="@layout/a_design_003_trans2"/>
                            </LinearLayout>
                        </ScrollView>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:id="@+id/llTranscript"
                            >
                            <!--                                            <include layout="@layout/a_design_003_trans3"/>-->
                            <ListView
                                android:id="@+id/viewListViewBook"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:cacheColorHint="#00000000"
                                android:divider="@drawable/speech__main_menu_list_line"
                                android:listSelector="#00000000"
                                />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:orientation="horizontal"
                    >
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        >
                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#585858"
                            app:cardCornerRadius="30dp"
                            app:cardElevation="0dp"
                            android:layout_gravity="center|center_vertical"
                            android:layout_margin="5dp"
                            android:id="@+id/stopRecord"
                            android:visibility="gone"
                            >
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="20dp"
                                >
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitCenter"
                                    android:textSize="11sp"
                                    android:textAllCaps="true"
                                    android:background="@drawable/ic_baseline_stop_24_white"
                                    android:text="PEN"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:tag="binding_1"
                                    android:layout_margin="10dp"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="18sp"
                                    android:text="Stop Recording"
                                    android:textColor="#ffffff"
                                    android:textStyle="bold"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:layout_marginRight="30dp"
                                    android:visibility="visible"
                                    />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#F6F3F2"
                            app:cardCornerRadius="30dp"
                            android:layout_gravity="center|center_vertical"
                            android:layout_margin="5dp"
                            android:id="@+id/startRecord"
                            android:visibility="visible"
                            >
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="20dp"
                                >
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitCenter"
                                    android:textSize="11sp"
                                    android:textAllCaps="true"
                                    android:background="@drawable/ic_baseline_fiber_manual_record_24"
                                    android:text="PEN"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:tag="binding_1"
                                    android:layout_margin="10dp"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="18sp"
                                    android:text="Start Record"
                                    android:textColor="#000000"
                                    android:textStyle="bold"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:layout_marginRight="30dp"
                                    android:visibility="visible"
                                    />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#F6F3F2"
                        app:cardCornerRadius="30dp"
                        android:layout_gravity="center|center_vertical"
                        android:layout_margin="5dp"
                        >
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="20dp"
                            >
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_centerVertical="true"
                                android:scaleType="fitCenter"
                                android:textSize="11sp"
                                android:textAllCaps="true"
                                android:background="@drawable/ic_baseline_pause_24"
                                android:text="PEN"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:tag="binding_1"
                                android:layout_margin="10dp"
                                />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:text="Pause"
                                android:textColor="#000000"
                                android:textStyle="bold"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginRight="30dp"
                                android:visibility="visible"
                                />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>


                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#00585858"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                android:layout_gravity="center|center_vertical"
                android:layout_margin="5dp"
                >
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#F4F0EF"
        app:cardCornerRadius="40px"
        app:cardElevation="1px"
        android:layout_gravity="center|center_vertical"
        android:paddingBottom="20px"
        >
    <!--#F1EDEC-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                >
                <!--#F6F3F2-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20px"
                    android:orientation="horizontal"
                    >
                    <TextView
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="22px"
                        android:text="Meeting"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:layout_gravity="center"
                        android:gravity="left"
                        android:layout_marginLeft="10px"
                        android:layout_marginRight="10px"
                        android:visibility="visible"
                        />
                    <ImageView
                        android:id="@+id/closeTrans"
                        android:layout_width="40px"
                        android:layout_height="40px"
                        android:src="@drawable/ic_baseline_close_24"
                        />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0px"
                    android:background="#FCF8F8"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <!--#ffffff-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/activity_book4_ai_panel_tab1_wrapper_height"
                        android:orientation="horizontal"
                        >
                        <RelativeLayout
                            android:layout_width="0px"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:id="@+id/rlInfo"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/activity_book4_ai_panel_tab1_text_size1"
                                android:text="Info"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:layout_gravity="center"
                                android:gravity="center|center_vertical"
                                android:visibility="visible"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                />
                            <View
                                android:layout_alignParentBottom="true"
                                android:layout_width="match_parent"
                                android:layout_height="1px"
                                android:background="#000000"
                                android:id="@+id/bottomLineInfo"
                                />
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="0px"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:id="@+id/rlTranscript"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/activity_book4_ai_panel_tab1_text_size1"
                                android:text="Transcript"
                                android:textStyle="bold"
                                android:textColor="#000000"
                                android:layout_gravity="center"
                                android:gravity="center|center_vertical"
                                android:visibility="visible"
                                android:layout_centerHorizontal="true"
                                android:layout_centerVertical="true"
                                />
                            <View
                                android:layout_alignParentBottom="true"
                                android:layout_width="match_parent"
                                android:layout_height="1px"
                                android:background="#000000"
                                android:visibility="invisible"
                                android:id="@+id/bottomLineTranscript"
                                />
                        </RelativeLayout>
                    </LinearLayout>

                    <View
                        android:layout_alignParentBottom="true"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:background="#cccccc"
                        />


                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:id="@+id/llInfo"
                            android:visibility="visible"
                            >
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                >
                                <include layout="@layout/activity_book4_ai_panel_tab1"/>
                            </LinearLayout>
                        </ScrollView>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:id="@+id/llTranscript"
                            android:background="#F4F0EF"
                            >
                            <!--                                            <include layout="@layout/a_design_003_trans3"/>-->
                            <ListView
                                android:id="@+id/viewListViewBook"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:cacheColorHint="#00000000"
                                android:divider="@null"
                                android:listSelector="#00000000"
                                />

                            <!--
                             android:divider="@drawable/speech__main_menu_list_line"
                               -->
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#464A4A"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >
                    <RadioGroup
                        android:id="@+id/rgASR"
                        android:checkedButton="@id/rbASR1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >
                        <RadioButton
                            android:id="@+id/rbASR1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:enabled="true"
                            android:paddingStart="0dp"
                            android:text="vosk, model-en-us"/>
                        <RadioButton
                            android:id="@+id/rbASR2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:checked="false"
                            android:enabled="true"
                            android:paddingStart="0dp"
                            android:text="sherpa-onnx, en-20M"/>
                        <RadioButton
                            android:id="@+id/rbASR3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:checked="false"
                            android:enabled="true"
                            android:paddingStart="0dp"
                            android:text="sherpa-onnx, en-kroko"/>
                    </RadioGroup>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/activity_book4_ai_panel_rec_btn_height"
                    android:orientation="horizontal"
                    >
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical|center"
                        android:layout_marginLeft="@dimen/activity_book4_ai_panel_rec_btn1_margin_left"
                        >
                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#585858"
                            app:cardCornerRadius="@dimen/activity_book4_ai_panel_rec_btn1_corner"
                            app:cardElevation="0px"
                            android:layout_gravity="center|center_vertical"
                            android:layout_margin="@dimen/activity_book4_ai_panel_rec_btn1_margin"
                            android:id="@+id/stopRecord"
                            android:visibility="gone"
                            android:layout_centerInParent="true"
                            android:foreground="?android:attr/selectableItemBackground"
                            >
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="@dimen/activity_book4_ai_panel_rec_btn1_padding_left"
                                >
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="@dimen/activity_book4_ai_panel_rec_btn1_iv_height"
                                    android:layout_height="@dimen/activity_book4_ai_panel_rec_btn1_iv_height"
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitCenter"
                                    android:textSize="11px"
                                    android:textAllCaps="true"
                                    android:src="@drawable/ic_baseline_stop_24_white2"
                                    android:text="PEN"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:tag="binding_1"
                                    android:layout_margin="@dimen/activity_book4_ai_panel_rec_btn1_iv_margin"
                                    />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/activity_book4_ai_panel_rec_btn1_tv_text_size"
                                    android:text="Stop Recording"
                                    android:textColor="#ffffff"
                                    android:textStyle="bold"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:layout_marginRight="@dimen/activity_book4_ai_panel_rec_btn1_tv_margin_right"
                                    android:visibility="visible"
                                    />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#F6F3F2"
                            app:cardCornerRadius="@dimen/activity_book4_ai_panel_rec_btn1_corner"
                            android:layout_gravity="center|center_vertical"
                            android:layout_marginLeft="@dimen/activity_book4_ai_panel_rec_btn1_margin"
                            android:id="@+id/startRecord"
                            android:visibility="visible"
                            android:layout_centerInParent="true"
                            app:cardElevation="0px"
                            android:foreground="?android:attr/selectableItemBackground"
                            >
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="@dimen/activity_book4_ai_panel_rec_btn1_padding_left"
                                android:background="@drawable/border_background"
                                android:id="@+id/llStartRecordOuter"
                                >
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/ivStartRecord"
                                    android:layout_width="@dimen/activity_book4_ai_panel_rec_btn1_iv_height"
                                    android:layout_height="@dimen/activity_book4_ai_panel_rec_btn1_iv_height"
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitCenter"
                                    android:textSize="11px"
                                    android:textAllCaps="true"
                                    android:src="@drawable/ic_baseline_fiber_manual_record_24_2"
                                    android:text="PEN"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:tag="binding_1"
                                    android:layout_margin="@dimen/activity_book4_ai_panel_rec_btn1_iv_margin"
                                    />
                                <!--
                                android:src="@drawable/ic_baseline_fiber_manual_record_24"
                                    -->
                                <TextView
                                    android:id="@+id/tvStartRecord"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/activity_book4_ai_panel_rec_btn1_tv_text_size"
                                    android:text="Start Recording"
                                    android:textColor="#000000"
                                    android:textStyle="bold"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:layout_marginRight="@dimen/activity_book4_ai_panel_rec_btn1_tv_margin_right"
                                    android:visibility="visible"
                                    />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical|center"
                        android:layout_marginLeft="0px"
                        >
                        <androidx.cardview.widget.CardView
                            android:id="@+id/pauseRecordOff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#F6F3F2"
                            app:cardCornerRadius="@dimen/activity_book4_ai_panel_rec_btn1_corner"
                            android:layout_gravity="center|center_vertical"
                            android:layout_margin="@dimen/activity_book4_ai_panel_rec_btn1_margin"
                            android:layout_marginLeft="@dimen/activity_book4_ai_panel_rec_btn1_margin"
                            android:visibility="visible"
                            android:layout_centerInParent="true"
                            app:cardElevation="0px"
                            android:foreground="?android:attr/selectableItemBackground"
                            >
                            <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="@dimen/activity_book4_ai_panel_rec_btn1_padding_left"
                            android:background="@drawable/border_background"
                            android:id="@+id/llPauseRecordOffOuter"
                            >
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivPauseRecordOff"
                                android:layout_width="@dimen/activity_book4_ai_panel_rec_btn1_iv_height"
                                android:layout_height="@dimen/activity_book4_ai_panel_rec_btn1_iv_height"
                                android:layout_centerVertical="true"
                                android:scaleType="fitCenter"
                                android:textSize="11px"
                                android:textAllCaps="true"
                                android:src="@drawable/ic_baseline_pause_24"
                                android:text="PEN"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:tag="binding_1"
                                android:layout_margin="@dimen/activity_book4_ai_panel_rec_btn1_iv_margin"
                                />
                            <TextView
                                android:id="@+id/tvPauseRecordOff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/activity_book4_ai_panel_rec_btn1_tv_text_size"
                                android:text="Pause"
                                android:textColor="#000000"
                                android:textStyle="bold"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginRight="@dimen/activity_book4_ai_panel_rec_btn1_tv_margin_right"
                                android:visibility="visible"
                                />
                        </LinearLayout>
                        </androidx.cardview.widget.CardView>
                        <androidx.cardview.widget.CardView
                            android:id="@+id/pauseRecordOn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#585858"
                            app:cardCornerRadius="@dimen/activity_book4_ai_panel_rec_btn1_corner"
                            android:layout_gravity="center|center_vertical"
                            android:layout_margin="@dimen/activity_book4_ai_panel_rec_btn1_margin"
                            android:layout_marginLeft="@dimen/activity_book4_ai_panel_rec_btn1_margin"
                            android:visibility="gone"
                            android:layout_centerInParent="true"
                            android:foreground="?android:attr/selectableItemBackground"
                            >
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingLeft="@dimen/activity_book4_ai_panel_rec_btn1_padding_left"
                                >
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/ivPauseRecordOn"
                                    android:layout_width="@dimen/activity_book4_ai_panel_rec_btn1_iv_height"
                                    android:layout_height="@dimen/activity_book4_ai_panel_rec_btn1_iv_height"
                                    android:layout_centerVertical="true"
                                    android:scaleType="fitCenter"
                                    android:textSize="11px"
                                    android:textAllCaps="true"
                                    android:src="@drawable/ic_baseline_pause_24_white2"
                                    android:text="PEN"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:tag="binding_1"
                                    android:layout_margin="@dimen/activity_book4_ai_panel_rec_btn1_iv_margin"
                                    />
                                <!--
                                android:src="@drawable/ic_baseline_pause_24_white"
                                    -->
                                <TextView
                                    android:id="@+id/tvPauseRecordOn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/activity_book4_ai_panel_rec_btn1_tv_text_size"
                                    android:text="Resume"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    android:layout_gravity="center"
                                    android:gravity="center"
                                    android:layout_marginRight="@dimen/activity_book4_ai_panel_rec_btn1_tv_margin_right"
                                    android:visibility="visible"
                                    />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </RelativeLayout>

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#00585858"
                app:cardCornerRadius="30px"
                app:cardElevation="0px"
                android:layout_gravity="center|center_vertical"
                android:layout_margin="5px"
                >
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
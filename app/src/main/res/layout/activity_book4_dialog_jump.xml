<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="633px"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="10px"
    android:id="@+id/llTopJump"
    android:visibility="visible"
    >
    <!--
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="0px"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="600px"
            android:layout_gravity="left|top"
            >
            <!--
            android:layout_height="600px"
            androidx.cardview.widget.CardView
            android:layout_height="match_parent"
            app:cardBackgroundColor="#00585858"
            app:cardCornerRadius="0px"
            app:cardElevation="0px"
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_margin="20px"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="1px"
                    android:orientation="horizontal"
                    >
                    <TextView
                        android:id="@+id/tvDialogTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24px"
                        android:text="Note pages"
                        android:textColor="#000000"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:layout_marginLeft="10px"
                        android:layout_marginRight="10px"
                        android:visibility="visible"
                        />
                    <!--New note-->
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right"
                    android:layout_marginTop="10px"
                    android:layout_marginBottom="10px"
                    >
                        <RelativeLayout
                            android:layout_width="114px"
                            android:layout_height="40px"
                            android:orientation="horizontal"
                            android:background="@drawable/button_outline"
                            android:id="@+id/btnReorder"
                            android:gravity="center|center_vertical"
                            android:layout_marginRight="10px"
                            >
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reorder"
                                android:textAllCaps="false"
                                android:id="@+id/btnReorderText"
                                android:textSize="14px"
                                android:background="@android:color/transparent"
                                />
                        </RelativeLayout>

<!--
android:backgroundTint="#000"
android:textColor="#FFFFFFFF"
-->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            >

                            <RelativeLayout
                                android:layout_width="134px"
                                android:layout_height="40px"
                                android:background="@drawable/button_outline"
                                android:padding="0px"
                                android:layout_marginRight="18px"
                                android:gravity="center|center_vertical"
                                android:id="@+id/btnSelect"
                                >
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|top"
                                    android:text="Select Page"
                                    android:textAllCaps="false"
                                    android:id="@+id/btnSelectText"
                                    android:textSize="14px"
                                    android:background="@android:color/transparent"
                                    />
                            </RelativeLayout>

                            <RelativeLayout
                                android:layout_width="134px"
                                android:layout_height="40px"
                                android:orientation="horizontal"
                                android:background="@drawable/button_outline"
                                android:id="@+id/btnDuplicate"
                                android:gravity="center|center_vertical"
                                android:layout_marginRight="10px"
                                >
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|top"
                                    android:text="Duplicate"
                                    android:textColor="#CCCCCC"
                                    android:textAllCaps="false"
                                    android:textSize="14px"
                                    android:background="@android:color/transparent"
                                    android:id="@+id/btnDuplicateText"
                                    />
                            </RelativeLayout>

                            <RelativeLayout
                                android:layout_width="101px"
                                android:layout_height="40px"
                                android:background="@drawable/button_outline"
                                android:padding="0px"
                                android:id="@+id/btnDelete"
                                android:gravity="center|center_vertical"
                                >
                                <ImageView
                                    android:layout_width="20px"
                                    android:layout_height="20px"
                                    android:background="@drawable/ic_outline_delete_forever_24"
                                    android:layout_gravity="center_vertical|center"
                                    android:id="@+id/btnDeleteTextIcon"
                                    />
                                <TextView
                                    android:id="@+id/btnDeleteText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical|left"
                                    android:text="Delete"
                                    app:iconPadding="0px"
                                    android:textColor="#CCC"
                                    android:textAllCaps="false"
                                    android:drawableTint="#FFCCCCCC"
                                    android:textSize="14px"
                                    android:background="@android:color/transparent"
                                    android:layout_toRightOf="@+id/btnDeleteTextIcon"
                                    />
                            </RelativeLayout>
                            <!--app:icon-->
                        </LinearLayout>
                </LinearLayout>

                <com.txkj.drawingapp.activity.BookActivity4DragGridView
                    android:id="@+id/bookgridview"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:numColumns="2"
                    android:paddingLeft="0px"
                    android:paddingRight="0px"
                    android:stretchMode="columnWidth" />
                <!--
                android:layout_height="match_parent"

                 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="right"
                    android:layout_marginTop="16px"
                    android:layout_marginRight="-10px"
                    >
                    <Button
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="76px"
                        android:layout_height="40px"
                        android:text="Cancel"
                        android:textSize="14px"
                        app:icon="@null"
                        android:id="@+id/btnCancel"
                        android:padding="0px"
                        android:visibility="gone"
                        android:textColor="#000000"
                        />
                    <Button
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="76px"
                        android:layout_height="40px"
                        android:text="Close"
                        android:textSize="14px"
                        app:icon="@null"
                        android:id="@+id/btnSave"
                        android:padding="0px"
                        android:textColor="#000000"
                        />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

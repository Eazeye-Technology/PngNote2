<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CCFFFFFF"
    >

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:orientation="vertical"
        android:gravity="center|center_vertical"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/focus_mode_text_size1"
            android:text="This is focus mode "
            android:textColor="#000000"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/focus_mode_text_size2"
            android:text="Focus mode gets rid of distractions to enhance productivity."
            android:textColor="#000000"
            />
        <!--
            android:text="Focus mode gets rid of distractions to enhance productivity. Here's how to get started."
        -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/focus_mode_text_size3"
            android:text="Tap anywhere to dismiss"
            android:layout_marginTop="@dimen/focus_mode_margin1"
            android:textColor="#000000"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginRight="@dimen/focus_mode_margin2"
        android:layout_marginTop="@dimen/focus_mode_margin3"
        >
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/focus_mode_w1"
            android:layout_height="@dimen/focus_mode_h1"
            app:cardBackgroundColor="#585858"
            app:cardCornerRadius="@dimen/focus_mode_radius"
            app:cardElevation="@dimen/focus_mode_elevation"
            >
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                >
                <ImageView
                    android:layout_width="@dimen/focus_mode_w2"
                    android:layout_height="@dimen/focus_mode_h2"
                    android:src="@drawable/ic_my_focus_exit_001"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="@dimen/focus_mode_margin4"
                    />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/focus_mode_h3"
            />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#F1EDEC"
        app:cardCornerRadius="@dimen/focus_mode_radius"
        app:cardElevation="@dimen/focus_mode_elevation"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginRight="@dimen/focus_mode_margin5"
        android:layout_marginTop="@dimen/focus_mode_margin6"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap here to exit focus mode"
            android:textColor="#444444"
            android:layout_margin="@dimen/focus_mode_margin7"
            android:textSize="@dimen/focus_mode_text_size4"
            />
    </androidx.cardview.widget.CardView>

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_my_focus_double_tap_002"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="@dimen/focus_mode_margin8"
        android:layout_marginTop="@dimen/focus_mode_margin9"
        />

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#F1EDEC"
        app:cardCornerRadius="@dimen/focus_mode_radius"
        app:cardElevation="@dimen/focus_mode_elevation"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_marginLeft="@dimen/focus_mode_margin10"
        android:layout_marginTop="@dimen/focus_mode_margin11"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Double tap on the left or right of the page to move between pages"
            android:textColor="#444444"
            android:layout_margin="@dimen/focus_mode_margin12"
            android:textSize="@dimen/focus_mode_text_size5"
            />
    </androidx.cardview.widget.CardView>


    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_my_focus_swipe_003"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/focus_mode_margin13"
        android:visibility="gone"
        />

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#F1EDEC"
        app:cardCornerRadius="@dimen/focus_mode_radius"
        app:cardElevation="@dimen/focus_mode_elevation"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="@dimen/focus_mode_margin14"
        android:visibility="gone"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Swipe up to open focus panel"
            android:textColor="#444444"
            android:layout_margin="@dimen/focus_mode_margin15"
            />
    </androidx.cardview.widget.CardView>

</RelativeLayout>

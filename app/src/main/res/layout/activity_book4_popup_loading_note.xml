<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/activity_book4_popup_menu_width"
    android:layout_height="wrap_content"
    android:layout_marginLeft="50px"
    android:layout_marginTop="50px"
    android:orientation="horizontal">
    <!--300px-->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center|center_vertical"
        app:cardBackgroundColor="#DBDBDB"
        app:cardCornerRadius="40dp"
        app:cardElevation="@dimen/activity_book4_popup_menu_elevation">
        <!--#F1EDEC-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0px">
            <!--padding=10px-->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center|center_vertical"
                android:layout_margin="0px"
                android:background="@drawable/context_menu_outline"
                android:elevation="@dimen/activity_book4_popup_menu_elevation2"
                >
                <LinearLayout
                    android:layout_width="352px"
                    android:layout_height="316px"
                    android:orientation="vertical"
                    android:layout_centerInParent="true"
                    android:layout_marginLeft="24dp"
                    android:layout_marginRight="24dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    >
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/loading_note"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading note"
                        android:layout_gravity="center"
                        />
                </LinearLayout>
            </RelativeLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>

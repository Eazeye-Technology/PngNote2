<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0000"
    >

    <!--https://zhuanlan.zhihu.com/p/691513009-->
    <include
        android:id="@+id/ar_tb"
        layout="@layout/toolbar_base" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toTopOf="@+id/ar_recording_check_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ar_tb">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ar_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0000FF"
            android:padding="20dp" />

        <!--设置关键属性layout_behavior，外层父布局必须是CoordinatorLayout，behavior_hideable=是否显示，behavior_peekHeight=高度-->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/ar_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            app:behavior_hideable="true"
            app:behavior_peekHeight="200dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            app:layout_constraintBottom_toTopOf="@+id/ar_recording_check_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ar_tb">
<!--app:behavior_peekHeight="0dp"-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ar_recording_drag_handle"
                    android:layout_width="50dp"
                    android:layout_height="5dp"
                    android:layout_margin="10dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/ic_my_wav_001"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/ar_recording_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:inputType="text"
                    android:text="Record 1"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:ignore="Autofill,LabelFor" />

                <TextView
                    android:id="@+id/ar_recording_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="00:00:20"
                    android:textColor="#CCCCCC"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/ar_recording_anim"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/ic_my_wav_001"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/ar_recording_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:autofillHints=""
                    android:background="@null"
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:text="123456"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    tools:ignore="LabelFor" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <RelativeLayout
        android:id="@+id/ar_recording_check_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ContentDescription"
        >

        <CheckBox
            android:id="@+id/ar_recording_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            tools:ignore="ContentDescription"
            android:text="hello"/>
        <!--android:background="@drawable/selector_select_check5"
            -->
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

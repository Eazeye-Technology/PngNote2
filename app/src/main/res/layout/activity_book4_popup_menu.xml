<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="50dp"
    android:layout_marginLeft="50dp"
    >
    <!--300dp-->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#F1EDEC"
        app:cardCornerRadius="10dp"
        app:cardElevation="1dp"
        android:layout_gravity="center|center_vertical"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp"
            >
            <!--padding=10dp-->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#00585858"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                android:layout_gravity="center|center_vertical"
                android:layout_margin="5dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_content_copy_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:text="Copy"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_content_paste_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:text="Paste"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_content_cut_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:text="Cut"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="0dp"
                            android:layout_weight="0"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_content_cut_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="visible"
                            />
                        <TextView
                            android:id="@+id/popTextViewInsertImage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:text="Insert image..."
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#000000"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        >
                        <!--android:background="@drawable/toolbar_button2"
                        -->

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            >
                            <ImageButton
                                android:layout_width="@dimen/mtmobile__treefontsize5"
                                android:layout_height="@dimen/mtmobile__treefontsize5"
                                android:layout_centerVertical="true"
                                android:scaleType="fitCenter"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp"
                                android:textColor="@color/black"
                                android:textSize="11sp"
                                android:textAllCaps="true"
                                android:background="@drawable/toolbar_button"
                                android:id="@+id/popButtonGrid"
                                android:src="@drawable/baseline_grid_view"
                                android:text="GRID"
                                android:layout_gravity="center"
                                android:gravity="center"
                                />
                            <TextView
                                android:id="@+id/line_thickness_buttontxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/mtmobile__treefontsize4"
                                android:text="Grid"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginLeft="10px"
                                android:layout_marginRight="10px"
                                android:visibility="gone"
                                />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:id="@+id/linearTextAnnot"
                            android:layout_marginLeft="20dp"
                            >
                            <ImageButton
                                android:layout_width="@dimen/mtmobile__treefontsize5"
                                android:layout_height="@dimen/mtmobile__treefontsize5"
                                android:layout_centerVertical="true"
                                android:scaleType="fitCenter"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp"
                                android:textColor="@color/black"
                                android:textSize="11sp"
                                android:textAllCaps="true"
                                android:background="@drawable/toolbar_button"
                                android:id="@+id/popButtonPrevPage"
                                android:src="@drawable/baseline_chevron_left"
                                android:text="PREV PAGE"
                                android:layout_gravity="center"
                                android:gravity="center"
                                />
                            <TextView
                                android:id="@+id/note_buttontxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/mtmobile__treefontsize4"
                                android:text="Prev Page"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginLeft="10px"
                                android:layout_marginRight="10px"
                                android:visibility="gone"
                                />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/popTextViewPageInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/mtmobile__treefontsize5"
                            android:text="1/1"
                            android:textStyle="bold"
                            android:gravity="center|center_vertical"
                            android:textSize="20dp"
                            android:layout_marginLeft="20dp"
                            />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginLeft="20dp"
                            >
                            <ImageButton
                                android:layout_width="@dimen/mtmobile__treefontsize5"
                                android:layout_height="@dimen/mtmobile__treefontsize5"
                                android:layout_centerVertical="true"
                                android:scaleType="fitCenter"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp"
                                android:textColor="@color/black"
                                android:textSize="11sp"
                                android:textAllCaps="true"
                                android:background="@drawable/toolbar_button"
                                android:id="@+id/popButtonNextPage"
                                android:src="@drawable/baseline_chevron_right"
                                android:text="NEXT PAGE"
                                android:layout_gravity="center"
                                android:gravity="center"
                                />
                            <TextView
                                android:id="@+id/delete_buttontxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/mtmobile__treefontsize4"
                                android:text="Next Page"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginLeft="10px"
                                android:layout_marginRight="10px"
                                android:visibility="gone"
                                />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            >

                            <!--ic_baseline_remove_24-->
                            <ImageButton
                                android:id="@+id/popButtonRemovePage"
                                android:layout_width="@dimen/mtmobile__treefontsize5"
                                android:layout_height="@dimen/mtmobile__treefontsize5"
                                android:layout_centerVertical="true"
                                android:layout_gravity="center"
                                android:background="@drawable/toolbar_button"
                                android:gravity="center"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/trash_can_solid_3"
                                android:text="REMOVE PAGE"
                                android:textAllCaps="true"
                                android:textColor="@color/black"
                                android:textSize="11sp"
                                android:visibility="gone"
                                />

                            <TextView
                                android:id="@+id/remove_buttontxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/mtmobile__treefontsize4"
                                android:text="Remove page"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginLeft="10px"
                                android:layout_marginRight="10px"
                                android:visibility="gone"
                                />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginLeft="20dp"
                            >
                            <ImageButton
                                android:layout_width="@dimen/mtmobile__treefontsize5"
                                android:layout_height="@dimen/mtmobile__treefontsize5"
                                android:layout_centerVertical="true"
                                android:scaleType="fitCenter"
                                android:paddingLeft="5dp"
                                android:paddingRight="5dp"
                                android:textColor="@color/black"
                                android:textSize="11sp"
                                android:textAllCaps="true"
                                android:background="@drawable/toolbar_button"
                                android:id="@+id/popButtonAddPage"
                                android:src="@drawable/ic_baseline_add_24"
                                android:text="ADD PAGE"
                                android:layout_gravity="center"
                                android:gravity="center"
                                />
                            <TextView
                                android:id="@+id/close_buttontxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/mtmobile__treefontsize4"
                                android:text="Add page"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:layout_marginLeft="10px"
                                android:layout_marginRight="10px"
                                android:visibility="gone"
                                />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#000000"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="0dp"
                            android:layout_weight="0"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_content_cut_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="visible"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:text="Rename file..."
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            android:id="@+id/popTextViewRenameFile"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="0dp"
                            android:layout_weight="0"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_content_cut_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="visible"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:text="Page background..."
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            android:id="@+id/popTextViewPageBackground"
                            />
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="0dp"
                            android:layout_weight="0"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_content_cut_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="visible"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp"
                            android:text="Move canvas"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="left"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            android:id="@+id/popButtonPan"
                            />
                        <!-- (or press SPACE key, the emulator needs to enable Hardware Input)-->
                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#000000"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_share_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="visible"
                            />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="20sp"
                            android:text="Share..."
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="left"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            android:id="@+id/popButtonShare"
                            />

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_arrow_right_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="visible"
                            />
                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#000000"
                        />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="1dp"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="0"
                            android:layout_centerVertical="true"
                            android:scaleType="fitCenter"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:src="@drawable/ic_baseline_share_24"
                            android:text="PEN"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:visibility="invisible"
                            />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="20sp"
                            android:text="Shortcuts"
                            android:textColor="#000000"
                            android:layout_gravity="center"
                            android:gravity="left"
                            android:layout_marginLeft="10px"
                            android:layout_marginRight="10px"
                            android:visibility="visible"
                            android:id="@+id/popButtonShortcut"
                            />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
